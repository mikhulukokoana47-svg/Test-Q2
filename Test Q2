import java.util.Scanner;

public class RunApplication {

    interface IBeverage {
        String getBeverageType();
        String getCity();
        int getTotalSales();
    }

    static abstract class Beverage implements IBeverage {
        String beverageType;
        String city;
        int totalSales;

        public Beverage(String beverageType, String city, int totalSales) {
            this.beverageType = beverageType;
            this.city = city;
            this.totalSales = totalSales;
        }

        @Override
        public String getBeverageType() {
            return beverageType;
        }

        @Override
        public String getCity() {
            return city;
        }

        @Override
        public int getTotalSales() {
            return totalSales;
        }
    }

    static class BeverageSales extends Beverage {

        public BeverageSales(String beverageType, String city, int totalSales) {
            super(beverageType, city, totalSales);
        }

        public void printReport() {
            System.out.println("\nNUMBER 1 COFFEE HUT REPORT");
            System.out.println("--------------------------");
            System.out.println("BEVERAGE TYPE: " + getBeverageType());
            System.out.println("CITY: " + getCity());
            System.out.println("TOTAL SALES: " + getTotalSales());
        }
    }

    public static void main(String[] args) {
        try (Scanner input = new Scanner(System.in)) {
            System.out.println("Select the beverage type");
            System.out.println("1) COFFEE");
            System.out.println("2) TEA");
            System.out.println("3) SODA");
            System.out.print("Enter choice: ");
            
            int choice = input.nextInt();
            input.nextLine();
            
            String type;
            
            switch (choice) {
                case 1 -> type = "COFFEE";
                case 2 -> type = "TEA";
                case 3 -> type = "SODA";
                default -> {
                    System.out.println("Invalid choice!");
                    input.close();
                    return;
                }
            }
            
            System.out.print("Enter the city: ");
            String city = input.nextLine();
            
            System.out.print("Enter the total sales: ");
            int total = input.nextInt();
            
            BeverageSales sales = new BeverageSales(type, city, total);
            sales.printReport();
        }
    }
}
